{
  "manifest_version": 3,
  "name": "MyCRWL Website Intelligence",
  "description": "AI-powered website crawler, brand analyzer, and PDF report generator.",
  "version": "1.0.0",
  "action": {
    "default_title": "Analyze Website"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"]
}
